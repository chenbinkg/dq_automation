# -- SMTP Configurations --
# SMTP relay/server hostname
SMTP_HOST=smtp.na.jnj.com
# SMTP port (587 for STARTTLS, 465 for implicit SSL)
SMTP_PORT=25
# From address shown in outgoing notifications
SMTP_FROM=NOREPLY@ITS.JNJ.com
# Enable STARTTLS negotiation on plain SMTP connections
SMTP_USE_TLS=False
# Enable implicit SSL (typically set True only with port 465)
SMTP_USE_SSL=False
# Optional allowlist for recipient domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=jnj.com,its.jnj.com
