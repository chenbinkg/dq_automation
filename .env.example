JIRA_API_TOKEN=
JIRA_URL=https://jira.jnj.com
JIRA_PROJECT_KEYS=JGPV
# Retry count across all retryable failures (connection/read/http status)
JIRA_HTTP_TOTAL_RETRIES=5
# Retry count specifically for connection setup failures
JIRA_HTTP_CONNECT_RETRIES=5
# Retry count specifically for socket read timeouts
JIRA_HTTP_READ_RETRIES=5
# Exponential backoff factor between retries: 1.0 -> 1s, 2s, 4s...
JIRA_HTTP_BACKOFF_FACTOR=1.0

